{
  "name": "sws-platinum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "assets:extract": "node scripts/extract-assets.mjs",
    "reference:extract": "node scripts/extract-reference-assets.mjs && node scripts/extract-reference-mappings.mjs && node scripts/reference-report.mjs",
    "assets:cards": "node scripts/prepare-cards.mjs",
    "reference:report": "node scripts/reference-report.mjs",
    "reference:test": "node tests-node/delphi.test.mjs && node tests-node/mappings.test.mjs",
    "engine:test": "node tests-node/engine.test.mjs && node tests-node/lifecycle.test.mjs && node tests-node/game.test.mjs && node tests-node/legacy.test.mjs",
    "ai:build": "node scripts/build-ai.mjs",
    "assets:audio": "python scripts/prepare-audio.py",
    "assets:setup": "node scripts/prepare-setup.mjs",
    "assets:dialogs": "node scripts/prepare-dialogs.mjs",
    "audio:test": "node tests-node/audio.test.mjs",
    "commentary:test": "node tests-node/commentary-triggers.test.mjs && node tests-node/commentary.test.mjs",
    "assets:commentary": "node scripts/prepare-commentary.mjs",
    "engine:fixtures": "node scripts/prepare-engine-fixtures.mjs",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler dev"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.2.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "wrangler": "4.157.0"
  }
}
